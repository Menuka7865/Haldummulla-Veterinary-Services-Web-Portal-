# Environment Variables — copy this file to .env and fill in your values

# MongoDB connection string (e.g. from MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/haldummullavet?retryWrites=true&w=majority

# Secret key used to sign JWT tokens — use a long, random string in production
JWT_SECRET=your_super_secret_jwt_key_here

# Port the backend server will listen on
PORT=5000
